# Rezekify Environment Variables Example

# App
PROJECT_NAME=rezekify
ENVIRONMENT=development
DEBUG=True

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rezekify
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/rezekify

# Security
SECRET_KEY=replace-with-a-very-secure-random-secret-key-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# LLM API Keys (comma-separated for RotaryKeyPool)
GEMINI_API_KEYS=key1,key2,key3
GROQ_API_KEYS=key1,key2

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
